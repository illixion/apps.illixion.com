// Static assets only: no Worker script. Website/ is generated by scripts/altsource.py and
// committed, so there is no build step. Website/_headers (CSP, CORS on source.json) is applied
// by the assets runtime.
{
  "name": "apps-illixion",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "./Website"
  }
}
